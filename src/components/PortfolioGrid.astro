---
import { Image } from "astro:assets";

interface Props {
    images: {
    src: string;
    alt?: string;
    }[];
    height: number;
    }

const { images, height } = Astro.props;
---

<div class="display-images" style={`--image-count: ${images.length}`}>
    {images.map((image) => (
        <div>
            <img src={image.src} alt={image.alt ?? ""} class="display" style={`max-height: ${height}px`}/>
            <p>Demo Text</p>
        </div>
    ))}
</div>

<style>
    .display-images {
        display: grid;
        grid-template-columns: repeat(var(--image-count), minmax(0, 1fr));
        gap: 10px;
        max-width: 80vw;
    }

    .display-images img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media screen and (max-width: 900px) {
        .display-images {
            max-width: 90%;
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
