---

import { Font } from "astro:assets"

const { message } = Astro.props;

---

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < 0.5) {
                entry.target.classList.remove("animate__animated", "animate__fadeIn");
            } else {
                entry.target.classList.add("animate__animated", "animate__fadeIn");
            }
        });
    }, {
        threshold: 0.5
    });

    document.querySelectorAll(".subheader h2").forEach((element) => {
        observer.observe(element);
    });

</script>

<Font cssVariable='--font-dela-gothic-one' preload />
<div class="subheader">
    <h2>{ message }</h2>
</div>

<style>
    .subheader {
        color: #c83131;
        font-size: 43px;
        justify-content: center;
        display: flex;
        margin: 40px auto 0;
        text-align: center;
        font-family: var(--font-dela-gothic-one);
    }

    .subheader h2 {
        text-shadow: rgba(255,0,13,0.9) 0 0 57px;
        opacity: 0;
    }

    .subheader h2.animate__animated {
        opacity: 1;
    }

    @media screen and (max-width: 1024px) {
        .subheader {
            font-size: 1.7rem;
        }
    }
</style>
