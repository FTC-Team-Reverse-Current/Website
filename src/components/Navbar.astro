---
import { Font } from "astro:assets";
---

<div id="navbar-menu" class="navbar-menu">
  <Font cssVariable="--font-jersey-10" />
  <a href="/">Home</a>
  <a href="/team">Team</a>
  <a href="/portfolio">Portfolio</a>
  <a href="/resources">Resources</a>
  <a href="/contact">Contact</a>
</div>

<style>
  .navbar-menu {
    width: 100%;
    margin: 0;
    background-color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 150px;
    padding: 0;
  }

  .navbar-menu a {
    text-align: center;
    padding: 20px 0;
    text-decoration: none;
    font-size: 2.5rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #FFFFFF;
    font-family: var(--font-jersey-10);
  }

  .navbar-menu a:hover {
    color: #F54927;
  }
</style>
