---
import { Font } from "astro:assets";
import Square from "../assets/square.svg"
---

<div id="navbar-menu" class="navbar-menu">
  <Square class="header-logo"/>
  <Font cssVariable="--font-jersey-10" />
  <a href="/">Home</a>
  <a href="/team">Team</a>
  <a href="/portfolio">Portfolio</a>
  <a href="/resources">Resources</a>
  <a href="/contact">Contact</a>
</div>

<style>
  .navbar-menu {
    width: 100%;
    margin: 0;
    background-color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1rem, 5vw, 150px);
    padding: 0;
  }

  .navbar-menu a {
    text-align: center;
    padding: 20px 0;
    text-decoration: none;
    font-size: 2.5rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #FFFFFF;
    font-family: var(--font-jersey-10);
  }

  .navbar-menu a:hover {
    color: #F54927;
  }

  .navbar-menu .header-logo {
    width: 60px;
    height: 60px;
  }

  @media screen and (max-width: 900px) {
    .navbar-menu {
      box-sizing: border-box;
      flex-wrap: wrap;
      padding: 0.2rem;
      gap: 1rem;
    }
    .navbar-menu a {
      font-size: clamp(1rem, 3vw, 2rem);
    }

    .navbar-menu .header-logo {
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
    }
  }
</style>
