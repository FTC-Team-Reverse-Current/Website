---
import { Image } from "astro:assets";

interface Props {
    images: {
        src: string;
        alt?: string;
    }[];
    height: number;
}

const { images, height } = Astro.props;
---

<div class="display-images" style={`--image-count: ${images.length}`}>
    {images.map((image) => (
        <img src={image.src} alt={image.alt ?? ""} class="display" style={`max-height: ${height}px`}/>
    ))}
</div>

<style>
    .display-images {
        display: grid;
        grid-template-columns: repeat(var(--image-count), 1fr);
        gap: 10px;
        max-width: 80vw;
    }

    .display-images img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media screen and (max-width: 1024px) {
        .display-images {
            max-width: 90%;
        }
    }
</style>