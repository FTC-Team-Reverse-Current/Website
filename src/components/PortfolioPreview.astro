---

interface Props {
    cover: string;
    preview: string;
    title: string;
}

const { cover, preview, title } = Astro.props;
---

<div class="object">
    <a href="/portfolios/2026">
        <div class="image-container">
            <img src={ cover } alt="The 2026-27 Robot" class="grid-image image-one"/>
            <img src={ preview } alt="Preview of the 2026-27 Robot" class="grid-image image-two"/>
        </div>

        <div class="grid-text">
            <p>{ title }</p>
        </div>
    </a>
</div>

<style>
    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
    }

    .grid-image {
        object-fit: cover;
        object-position: center;
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        transition: opacity 0.4s ease-in-out;
    }

    .image-one {
        opacity: 1;
    }

    .image-two {
        opacity: 0;
    }

    .object:hover .image-one {
        opacity: 0;
    }

    .object:hover .image-two {
        opacity: 1;
    }

    .object {
        width: min(400px, 100%);
        background-color: black;
        transition: all 0.3s ease-in-out;
    }

    .object:hover {
        box-shadow: rgba(255,0,13,0.9) 0 0 57px;
    }

    .grid-text {
        margin: 20px 30px 30px;
        text-align: center;
        font-size: 2.7rem;
        color: white;
        font-family: var(--font-jersey-10);
        text-decoration: none;
    }

    .object:hover .grid-text {
        color: #F54927;
        transition: color 0.3s ease-in-out;
    }
</style>
