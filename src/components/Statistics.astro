---
import { Font } from "astro:assets";
import "animate.css";

const { season } = Astro.props;

let statsData = null;
let eventsData = null;
let seasonData = null;

let error = false;

try {
    const statsResponse = await fetch(
        `https://api.ftcscout.org/rest/v1/teams/36393/quick-stats?season=${season}`
    );

    const eventsResponse = await fetch(
        `https://api.ftcscout.org/rest/v1/teams/36393/matches?season=${season}`
    );

    const seasonResponse = await fetch(
        `https://api.ftcscout.org/rest/v1/teams/36393/events/${season}`
    );

    if (!statsResponse.ok || !eventsResponse.ok || !seasonResponse.ok) {
        throw new Error("API request failed");
    }

    statsData = await statsResponse.json();
    eventsData = await eventsResponse.json();
    seasonData = await seasonResponse.json();

} catch (err) {
    console.error("Failed to fetch FTCScout data:", err);
    error = true;
}

let wins = 0;

if (seasonData) {
    seasonData.forEach((item: any) => {
        if (item.stats) {
            wins += item.stats.wins;
        }
    });
}
---

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("animate__animated", "animate__fadeIn");
            } else {
                entry.target.classList.remove("animate__animated", "animate__fadeIn");
            }
        });
    }, {
        threshold: 0.5
    });

    document.querySelectorAll(".animate").forEach((element) => {
        observer.observe(element);
    });
</script>

{!error ? (
    <div class="grid-container">
        <Font cssVariable="--font-jersey-10" preload />
        <Font cssVariable='--font-jetbrains-mono' preload />
        <div class="object">
                <p>Matches</p>
                <h1 class="animate">{eventsData.length}</h1>
        </div>
        <div class="object">
                <p>Auto</p>
                <h1 class="animate">{statsData.auto.value.toFixed(2)}</h1>
        </div>
        <div class="object">
                <p>TeleOp</p>
                <h1 class="animate">{statsData.dc.value.toFixed(2)}</h1>
        </div>
        <div class="object">
                <p>Endgame</p>
                <h1 class="animate">{statsData.eg.value.toFixed(2)}</h1>
        </div>
        <div class="object">
                <p>Total</p>
                <h1 class="animate">{statsData.tot.value.toFixed(2)}</h1>
        </div>
        <div class="object">
                <p>Wins</p>
                <h1 class="animate">{wins}</h1>
        </div>
    </div>
): (
    <div class="error-message">
        <p>An error occurred while fetching the data...</p>
    </div>
    )}

<style>

    .grid-container {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        width: 100%;
        gap: 1rem;
        margin: 0 auto;
    }

    .object {
        color: white;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .object p {
        font-size: 2rem;
        font-family: var(--font-jetbrains-mono);
    }

    .object h1 {
        font-size: 8vw;
        font-family: var(--font-jersey-10);
        color: #c83131;
        text-shadow: rgba(255,0,13,0.6) 0 0 25px;
        opacity: 0;
        margin-top: 0.5rem;
    }

    .value h1.animate__animated {
        opacity: 1;
    }

    .error-message {
        color: red;
        font-size: 50px;
        font-family: var(--font-jetbrains-mono);
    }

    @media screen and (max-width: 900px) {
        .grid-container {
            width: 90%;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 0.2rem;
        }

        .object {
            backdrop-filter: none;
        }

        .object h1 {
            font-size: 16vw;
        }

        .object p {
            font-size: 3vw;
        }

        .error-message {
            font-size: 1.25rem;
            overflow-wrap: anywhere;
        }
    }
</style>
