---

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Marquee from "../components/Marquee.astro"
import { Image } from "astro:assets";
import firstRobot from '../assets/display/first-robot.jpg';
import oldSetup from '../assets/display/old-setup.jpg';
import chasisCad from '../assets/display/chasis-cad.jpg';
import fabricating from '../assets/display/fabricating.jpg';
import ImageGrid from "../components/ImageGrid.astro";
import versionOne from '../assets/display/version-one.jpg'
import watching from '../assets/display/watching.jpg'
import Square from '../assets/square.svg'
import Statistics from '../components/Statistics.astro';
import Subheading from "../components/Subheading.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---
<Layout>
  <div class="container">
    <Marquee message="WELCOME TO REVERSE CURRENT"/>
    <div class="header">
      <div class="title">
        <h1>WE ARE REVERSE CURRENT</h1>
      </div>
      <div class="subtitle">
        <p>Creating opportunities in STEM for all ages and redefining what is possible in FTC</p>
      </div>
    </div>
    <div class="display-container">
      <ImageGrid images={[
        { src: versionOne.src, alt: "Version one of our 2026 robot" },
        { src: watching.src, alt: "A competition photo" },
      ]} height={ 500 } />
    </div>
    <div class="text">
      <p>
        We are Reverse Current, a First Tech Challenge team from Dublin, Ohio.
        Reverse Current is commited to giving young students access to STEM and developing real skills in our members.
        Our team is pushing the boundaries of what a small, self-started team can do in First competitions.
      </p>
    </div>
    <Subheading message="THE STORY OF OUR TEAM"/>
    <div class="display-container">
      <ImageGrid images={[
        { src: firstRobot.src, alt: "Our first robot" },
        { src: oldSetup.src, alt: "Our original setup" },
        { src: chasisCad.src, alt: "Original chassis CAD" },
        { src: fabricating.src, alt: "Fabricating the wooden chassis" }
      ]} height={ 500 }/>
    </div>
    <div class="text">
      <p>
        Reverse Current is not entirely an original team. A lot of members carried over from a previous First Lego Team named the Aquabots.
        When it was announced that FLL would be discontinuing after the 2026-27 season, we needed to pivot, or risk losing nearly the entirety of Dublin's pre-high school STEM programs.
        The idea for Reverse Current was created the founding members saw the vast community of FTC at the First World Championships in Houston and knew what they had to do.
        Within a month, Reverse Current was formed, and our journey as a First Tech Challenge team began.
      </p>
    </div>
    <Subheading message="SEASON STATISTICS"/>
    <div class="text">
      <p>
        Here are our current team statistics pulled from the FTC Scout API. These are not completely accurate since they split the match scores between both team members.
      </p>
    </div>
    <div class="stats">
      <Statistics/>
    </div>
  </div>

  <style>

    .container {
      perspective: 1px;
      padding: 20px;
    }

    .title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .header {
      justify-content: center;
      flex-direction: column;
      display: flex;
      gap: 10px;
      margin-top: 60px;
    }

    .header h1{
      color: #c83131;
      font-size: 4vw;
      margin: 0 auto;
      justify-content: center;
      display: flex;
      font-family: var(--font-dela-gothic-one);
      text-shadow: rgba(255,0,13,0.9) 0 0 40px;
    }

    .header .header-logo {
      width: 4vw;
      height: 4vw;
      justify-content: center;
      display: flex;
    }

    .header p {
      color: #aeaeae;
      justify-content: center;
      display: flex;
      font-size: 25px;
      font-family: var(--font-jetbrains-mono);
    }

    .text {
      color: white;
      font-size: 36px;
      justify-content: center;
      display: flex;
      margin: 0 auto;
      max-width: 80vw;
      text-align: center;
      font-family: var(--font-geist-pixel);
    }

    .subheader {
      color: #c83131;
      font-size: 43px;
      justify-content: center;
      display: flex;
      margin: 40px auto 0;
      text-align: center;
      font-family: var(--font-dela-gothic-one);
    }

    .subheader h2 {
      text-shadow: rgba(255,0,13,0.9) 0 0 57px;
    }

    .display-container {
      display: flex;
      justify-content: center;
      margin: 50px auto;
    }

    .stats {
      display: flex;
      justify-content: center;
      max-width: 80vw;
      margin: 60px auto;
    }
  </style>
</Layout>
