---

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Text from "../components/Text.astro";
import DisplayLink from "../components/DisplayLink.astro";---

<Layout>
    <div class="container">
        <Header title="CONTACT" subtitle=""/>
        <Text text="
            Want to reach out or follow what we do? Email us or follow us on our socials.
        " bottomMargin="3vh"/>

        <DisplayLink items={[
            { title: "Instagram", href: "https://www.instagram.com/reverse.current.ftc/" },
            { title: "Email", href: "mailto:reversecurrent@outlook.com", display: "reversecurrent@outlook.com" },
        ]}/>
    </div>

    <style>
        .container {
            padding: 2rem;
        }

        .options {
            display: grid;
            grid-template-columns: repeat(3, 1fr)

        }

        .options p {
            color: white;
            font-size: 36px;
            justify-content: center;
            display: flex;
            font-family: var(--font-geist-pixel);
        }

        .instagram {
            display: flex;
            justify-content: center;
            margin: 0 auto;
        }

        .instagram blockquote {
            width: 100%;
        }
    </style>
</Layout>