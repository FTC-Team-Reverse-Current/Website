---

import Layout from "../layouts/Layout.astro";
import team from '../assets/display/team-comp-1.jpg';
import infront from '../assets/display/infront-different.webp';
import ImageGrid from "../components/ImageGrid.astro";
import Subheading from "../components/Subheading.astro";
import MentorBio from "../components/MentorBio.astro";

import michael from '../assets/bios/michael.jpg'
import keagan from '../assets/bios/keagan.jpg'
import gianmichael from '../assets/bios/gianmichael.jpg'
import Header from "../components/Header.astro";
import Text from "../components/Text.astro";

---

<Layout>
    <div class="container">
        <Header title="MEET OUR TEAM" subtitle={null}/>
        <ImageGrid images={[
            { src: team.src, alt: "The team from our first competition" },
            { src: infront.src, alt: "Another cool team photo" }
        ]} height={ 500 } />
        <div class="text">
            <p>
                Reverse Current is committed to giving students of all ages access to robotics. As a result our team is full of students from all ages, ranging from elementary school to high school.
                Our team also hosts students from different experience levels as well, with some having done robotics for years in FLL and FRC, and some with no experience at all. <span class="highlight">We welcome all who have a passion for robotics and a willingness to work!</span>
            </p>
        </div>
        <Subheading message="MEET OUR LEADS"/>
        <Text text="
            Leading Reverse Current are experienced robotics innovators and creatives. We would like you to meet some of them." bottomMargin="3vh"
        />
        <div class="bios">
            <MentorBio
                    name="Keagan Glover"
                    image={keagan.src}
                    role="Team Captain and Lead Mechanical"
                    bio="I am all about engineering, design, and building CAD skills. As a team, we have decided to take a CAD based design approach which will help us to create the best bot we can.
                Student based leadership is also important, as we created our team because we felt it would be best for us to teach and grow in robotics."
                    direction="left" />
            <MentorBio
                    name="Gianmichael R."
                    image={gianmichael.src}
                    role="Lead Programmer and Social Media"
                    bio="I love computers. I love STEM. I love a lot of other things too, but all in all, Reverse Current is a culmination of my favorite things.
                When I was asked at the Houston World Championships if I wanted to start an FTC team, I could not have responded faster than I did.
                Being able to collaborate with my friends and inspire a new generation of students is the greatest privilege I could have been given, and I cannot wait to continue pushing this team forward."
                    direction="right" />
        </div>
    </div>

    <style>
        .container {
            perspective: 1px;
            padding: 2rem;
        }

        .highlight {
            color: #c83131;
        }

        .text {
            color: white;
            font-size: 36px;
            justify-content: center;
            display: flex;
            max-width: 90%;
            text-align: center;
            font-family: var(--font-geist-pixel);
            margin: 2rem auto 10vh;
        }

        .bios {
            display: flex;
            justify-content: center;
            margin: 1rem auto;
            flex-direction: column;
        }

        @media screen and (max-width: 900px) {
            .container {
                width: 100%;
            }

            .display-container {
                margin: 1rem auto;
            }

            .text {
                max-width: 90%;
                font-size: 1.25rem;
                margin: 1rem auto;
            }

            .bios {
                margin: 1rem auto;
            }
        }
    </style>
</Layout>